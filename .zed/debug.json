// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "CodeLLDB",
    "label": "package '.'",
    "build": {
      "label": "odin debug build",
      "command": "odin",
      "request": "launch",
      "args": [
        "build",
        "w:\\puckman",
        "-out:debug_build.exe",
        "-debug",
        "--collection:odinlib=w:\\odinlib"
      ],
      "program": "debug_build",
      "env": {},
      "cwd":  "W:\\puckman",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "tags": [],
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
      "hooks": []
    },
    "preRunCommands": [
      "script import base64, types; odin = types.SimpleNamespace(); exec(base64.b64decode('').decode(), odin.__dict__); odin.__dict__['__lldb_init_module'](lldb.debugger, {})"
    ]
  },
  {
    "adapter": "CodeLLDB",
    "label": "puckman (CodeLLDB)",
    "request": "launch",
    "name": "puckman (CodeLLDB)",
    "program": "puckman",
    "stopOnEntry": false,
    "cwd": "W:\\puckman",
    "build": {
      "command": "odin",
      "args": ["build", "$ZED_WORKTREE_ROOT", "-debug", "--collection:odinlib=w:\\odinlib" ]
    },
  },
  {
    "adapter": "CodeLLDB",
    "label": "puckman SDL3 (CodeLLDB)",
    "request": "launch",
    "name": "puckman SDL3 (CodeLLDB)",
    "program": "puckman",
    "stopOnEntry": false,
    "cwd": "W:\\puckman",
    "build": {
      "command": "odin",
      "args": ["build", "$ZED_WORKTREE_ROOT", "-debug", "--collection:odinlib=w:\\odinlib", "-define:BACKEND=sdl"]
    },
  }
]
